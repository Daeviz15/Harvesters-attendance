# Public application configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://www.globeattendance.org

# Server-only Supabase credential. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required when self-hosting the same Next.js build on multiple server instances.
# Generate a base64-encoded 32-byte value and keep it stable across all instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only SMTP configuration. Personal Gmail is for controlled testing only.
# Production should use Google Workspace SMTP Relay or another transactional SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Gmail App Password profile (requires Google 2-Step Verification).
GOOGLE_EMAIL_ADDRESS=
GOOGLE_APP_PASSWORD=
# Optional and preferred Google OAuth2 profile. Configure all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Resend remains an explicit manual fallback only. It is used only when
# SMTP_HOST=smtp.resend.com; its normal account quotas still apply.
RESEND_API_KEY=
EMAIL_FROM_NAME=Harvesters Globe Attendance
# Must be an address or alias authorized by the SMTP provider.
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Comma-separated Gmail Send As aliases that have already been verified in the
# authenticated account. Never add an address that the account does not own.
EMAIL_GMAIL_AUTHORIZED_FROM_ADDRESSES=
EMAIL_MESSAGE_ID_DOMAIN=globeattendance.org

# Required only to run the controlled test from an @gmail.com account in a
# production Vercel environment. Remove it when moving to Workspace Relay.
EMAIL_ALLOW_PERSONAL_GMAIL_AUTOMATION=false

# Conservative defaults; tune only within the SMTP provider's documented limits.
SMTP_MAX_CONNECTIONS=1
SMTP_MAX_MESSAGES=50
SMTP_RATE_LIMIT=1

# Automatic notification processor
# Generate a cryptographically random ASCII value containing 32-256 characters.
EMAIL_CRON_SECRET=
# Keep false until reminder/follow-up delivery is intentionally rolled out.
EMAIL_AUTOMATION_ENABLED=false
# Test mode only lets automatic reminder/follow-up mail reach allowlisted
# recipients. Welcome emails are unaffected.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENTS=
# Keep false while testing event automation so old welcome jobs are not drained
# accidentally. Turn on deliberately if welcome outbox delivery should run here.
EMAIL_PROCESS_WELCOME_JOBS=false
# Local development only. Keep false unless you intentionally want localhost to
# run the automatic email processor every 60 seconds.
ENABLE_DEV_EMAIL_CRON=false
EMAIL_REMINDER_LEAD_MINUTES=30
EMAIL_FOLLOWUP_DELAY_MINUTES=60
# Recover follow-up jobs after scheduler outages for up to 24 hours. Reminders are
# always cancelled once their event has begun.
EMAIL_NOTIFICATION_MAX_LATENESS_MINUTES=1440
EMAIL_NOTIFICATION_BATCH_SIZE=10
EMAIL_NOTIFICATION_MAX_JOBS_PER_RUN=20
EMAIL_NOTIFICATION_LOCK_TIMEOUT_MINUTES=10
