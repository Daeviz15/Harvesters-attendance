                </div>
              </SheetContent>
            </Sheet>
          </div>
        </div>
      </header>

      {/* ──── Hero ──── */}
      <section className="relative mx-auto max-w-6xl px-6 pt-28 pb-20 md:pt-36 md:pb-28">
        <div className="relative grid items-center gap-12 md:grid-cols-2">
          {/* Text side */}
          <div className="animate-fade-in-up">
            <h1 className="mt-4 text-4xl font-extrabold leading-[1.08] tracking-tight text-white md:text-5xl lg:text-[3.5rem]">
              Harvesters is not just a space,
              <br />
              <span className="bg-gradient-to-r from-[#FF7A1A] via-[#E05D06] to-[#FF9E4D] bg-clip-text text-transparent">
