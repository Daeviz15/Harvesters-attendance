                <div className="mt-8 flex items-center justify-center gap-3">
                  <div className="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-[#E05D06] to-[#B34700] text-sm font-bold text-white shadow-md">
                    {t.initials}
