                <a
                  href="#"
                  className="flex h-8 w-8 items-center justify-center rounded-full bg-white/5 border border-white/10 text-neutral-400 transition-all hover:bg-[#E05D06] hover:text-white hover:border-[#E05D06]"
                  aria-label="Instagram"
                >
                  <InstagramIcon className="h-3.5 w-3.5" />
                </a>
                <a
                  href="#"
                  className="flex h-8 w-8 items-center justify-center rounded-full bg-white/5 border border-white/10 text-neutral-400 transition-all hover:bg-[#E05D06] hover:text-white hover:border-[#E05D06]"
                  aria-label="YouTube"
                >
                  <YoutubeIcon className="h-3.5 w-3.5" />
                </a>
              </div>
            </div>

            {/* Product */}
            <div>
              <h4 className="text-xs font-semibold uppercase tracking-widest text-[#FF7A1A]">
                Product
              </h4>
              <ul className="mt-3 space-y-2.5">
                <li><a href="#features" className="text-sm text-neutral-400 transition-colors hover:text-white">Features</a></li>
                <li><a href="#how" className="text-sm text-neutral-400 transition-colors hover:text-white">How it works</a></li>
                <li><a href="#faq" className="text-sm text-neutral-400 transition-colors hover:text-white">FAQ</a></li>
              </ul>
            </div>

            {/* Company */}
            <div>
              <h4 className="text-xs font-semibold uppercase tracking-widest text-[#FF7A1A]">
                Company
              </h4>
              <ul className="mt-3 space-y-2.5">
                <li><a href="#" className="text-sm text-neutral-400 transition-colors hover:text-white">About</a></li>
                <li><a href="#" className="text-sm text-neutral-400 transition-colors hover:text-white">Blog</a></li>
                <li><a href="#" className="text-sm text-neutral-400 transition-colors hover:text-white">Careers</a></li>
              </ul>
            </div>

            {/* Legal */}
            <div>
              <h4 className="text-xs font-semibold uppercase tracking-widest text-[#FF7A1A]">
                Legal
              </h4>
              <ul className="mt-3 space-y-2.5">
                <li><Link href="/privacy" className="text-sm text-neutral-400 transition-colors hover:text-white">Privacy</Link></li>
                <li><Link href="/terms" className="text-sm text-neutral-400 transition-colors hover:text-white">Terms</Link></li>
                <li><a href="mailto:feedback@harvestersng.org" className="text-sm text-neutral-400 transition-colors hover:text-white">Contact</a></li>
              </ul>
            </div>
          </div>

          <hr className="mt-10 border-white/10" />
          <div className="mt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-500">
            <span>© {new Date().getFullYear()} Harvesters Globe. All rights reserved.</span>
            <span>Made with ♥ for the local church.</span>
          </div>
        </div>
      </footer>
    </div>
  );
}
