            </p>
            <div className="mt-8 flex flex-wrap items-center gap-4">
              <Link href="/auth/signup">
                <Button variant="orange" className="px-7 py-3 text-sm rounded-xl">
                  Join our Community
                  <ArrowRight className="ml-2 h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                </Button>
              </Link>
              <Link href="/auth/login">
                <Button
                  variant="outline"
                  className="px-6 py-3 text-sm rounded-xl"
                >
                  Sign in
                </Button>
              </Link>
            </div>
          </div>

          {/* Image side */}
          <div className="relative animate-fade-in-scale" style={{ animationDelay: "0.2s" }}>
            {/* Ambient Background Glow */}
            <div className="absolute -inset-10 -z-10 rounded-full bg-gradient-to-tr from-[#E05D06]/25 via-[#E05D06]/10 to-transparent blur-3xl opacity-80" />

            {/* Frameless Hero Image with Seamless Blend */}
            <div className="relative w-full max-w-lg mx-auto">
